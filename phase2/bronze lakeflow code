import dlt
from pyspark.sql.functions import *

# ================================
# CONFIGURATION
# ================================
BRONZE_PATH = "s3://fitbit.bronze.6006/minute_data/"
SCHEMA_PATH = "s3://fitbit.bronze.6006/schema/"

# ================================
# BRONZE TABLE
# ================================
@dlt.table(
    name="bronze_fitbit_raw",
    comment="Raw Fitbit minute activity data",
    table_properties={
        "quality": "bronze",
        "pipelines.autoOptimize.managed": "true"
    }
)
def bronze_fitbit_raw():

    # Read schema if exists
    # Auto Loader handles schema
    # evolution automatically ✅

    return (
        spark.readStream
        .format("cloudFiles")
        .option(
            "cloudFiles.format",
            "json"
        )
        .option(
            "cloudFiles.schemaLocation",
            SCHEMA_PATH
        )
        .option(
            "cloudFiles.inferColumnTypes",
            "true"
        )
        .option(
            "cloudFiles.schemaEvolutionMode",
            "addNewColumns"          # Handle new columns ✅
        )
        .load(BRONZE_PATH)
        .withColumn(
            "ingestion_timestamp",
            current_timestamp()      # When ingested ✅
        )
        .withColumn(
            "source_file",
            input_file_name()        # Which file ✅
        )
        .withColumn(
            "data_source",
            lit("fitbit_simulator")  # Where from ✅
        )
        .withColumn(
            "pipeline_name",
            lit("fitbit_lakeflow")   # Which pipeline ✅
        )
    )
